# Змінні оточення сайту на Netlify (Site configuration → Environment variables).
# Локально: скопіювати в .env і запускати `netlify dev`.

# Токен від @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Секрет, який Telegram шле заголовком X-Telegram-Bot-Api-Secret-Token.
# Будь-який довгий рядок; функція відкидає запити без нього.
WEBHOOK_SECRET=

# Максимум фотографій в одному PDF (більше — ризик впертись у ліміт часу функції)
MAX_PHOTOS=20
